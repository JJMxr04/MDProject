{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowGetObjectFromSpecificDomains",
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::<bucket_name>/*",
            "Condition": {
                "StringLike": {
                    "aws:Referer": [
                        "https://paradise-sports-aaebe242ce78.herokuapp.com/admin/"
                    ]
                }
            }
        }
    ]
}

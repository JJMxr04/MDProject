# MDProject env. Copy to .env and edit. The .env file is loaded by
# python-dotenv at the top of CoreRoot/settings.py.
#
# Anything left blank below is REQUIRED in production (and surfaces a clear
# error at startup) — DEBUG, SECRET_KEY, ALLOWED_HOSTS in particular.

# ---------- Django core ----------
# Generate a real value with: ``python -c "import secrets; print(secrets.token_urlsafe(64))"``
SECRET_KEY=replace-me-with-a-real-64-byte-secret

# ``True`` enables Django's debug mode + auto-reload + dev-only HOST/cookie
# defaults. Must be ``False`` in production.
DEBUG=True

# Comma-separated. In DEBUG=True mode, ``localhost,127.0.0.1,testserver``
# are auto-added; in production set the actual hostname(s) you'll serve at.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Comma-separated full origins (scheme + host) trusted for cross-origin
# POSTs. Required for admin / portal forms to work over HTTPS behind
# Coolify's Traefik proxy. Empty in pure-localhost dev.
# Example: CSRF_TRUSTED_ORIGINS=https://app.example.com,https://admin.example.com
CSRF_TRUSTED_ORIGINS=

# ---------- Database ----------
# Local dev default: Homebrew Postgres 18 on port 5434.
DATABASE_URL=postgres://localhost:5434/mdproject?sslmode=disable

# ---------- Redis / Celery / channel layer ----------
REDIS_URL=redis://localhost:6379

# ---------- Email ----------
# Console backend prints emails to the runserver terminal — fine for dev.
# Production: switch to ``django.core.mail.backends.smtp.EmailBackend`` and
# fill in the SMTP creds below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_SSL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---------- Aggregator integration ----------
# Source-of-truth for events / odds / settlement. Set ``USE_AGGRIGATOR=False``
# only as a rollback escape hatch — every read in the portal expects True.
USE_AGGRIGATOR=True
AGGRIGATOR_BASE_URL=http://localhost:8001

# HMAC secret shared with the aggregator's AGG_WEBHOOK_SECRET. Used to
# verify inbound webhook signatures at /sportgameodds/webhook. Generate
# with: openssl rand -hex 32 (same value on both sides).
AGGRIGATOR_WEBHOOK_SECRET=

# HMAC secret for the OUTBOUND "Paradise" channel: MDProject → aggrigator
# internal API (/v1/internal/users, /v1/internal/users/{id}/entitlements,
# /v1/internal/users/{id}/api-keys/rotate). Same value as the aggregator's
# AGG_PARADISE_SECRET. NEVER reuse AGGRIGATOR_WEBHOOK_SECRET here — they
# sign opposite directions and a leak on one should not compromise the
# other. Generate with: openssl rand -hex 32. See subscription-plan/04-internal-api.md.
PARADISE_SECRET=

# ---------- SportsGameOdds (legacy local-DB path) ----------
# Only consulted when USE_AGGRIGATOR=False. With the aggregator on, leave
# the key blank — MDProject never calls SGO directly anymore.
SPORTSGAMEODDS_API_KEY=

# Dev-only knob: bypasses per-league cadence + per-event TTL + monthly cap
# in the legacy ingest path. NEVER set True in production — burns through
# the SGO entity quota in seconds.
EVENTS_DEBUG_FORCE_FRESH=False

# ---------- Stripe ----------
# STRIPE_SECRET_KEY: server-side API key (sk_test_* in dev, sk_live_* in prod).
#   Prefer a RESTRICTED key with: customers:write, subscriptions:write,
#   products:write, prices:write, checkout.sessions:write, billing_portal:write,
#   webhook_endpoints:write, events:read. Never expose to browsers/templates.
# STRIPE_PUBLISHABLE_KEY: only needed if using Stripe Elements/JS. The
#   subscription redirect flow does NOT need this — leave blank unless you
#   later add in-page card collection.
# STRIPE_WEBHOOK_SECRET: signing secret for /billing/stripe/webhook.
#   Dev: copy from the `stripe listen --forward-to ...` output.
#   Prod: copy from Stripe Dashboard → Developers → Webhooks → your endpoint.
#   Required — stripe.Webhook.construct_event() rejects requests without it.
# STRIPE_API_VERSION: pin so a Stripe-side API change can't silently break us.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-12-18.acacia
PLATFORM_COST=

# ---------- AWS S3 / media storage (Bucketeer add-on) ----------
BUCKETEER_AWS_ACCESS_KEY_ID=
BUCKETEER_AWS_SECRET_ACCESS_KEY=
BUCKETEER_BUCKET_NAME=
BUCKETEER_AWS_REGION=

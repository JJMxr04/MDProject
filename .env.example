# MDProject env. Copy to .env and edit. Loaded by python-dotenv at the
# top of CoreRoot/settings.py.

# --- Django core ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-real-64-byte-secret
DEBUG=True
# In DEBUG mode, localhost / 127.0.0.1 / testserver are auto-added.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Comma-separated full origins (scheme + host) trusted for cross-origin
# POSTs. Required for forms over HTTPS behind a reverse proxy.
CSRF_TRUSTED_ORIGINS=

# --- database (Homebrew Postgres 18, port 5434 by default) ---
DATABASE_URL=postgres://localhost:5434/mdproject?sslmode=disable

# --- redis / celery ---
REDIS_URL=redis://localhost:6379

# --- email (console backend prints to terminal; switch to smtp in prod) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_SSL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- aggregator integration ---
# True = read events/odds/settlement from the aggregator (canonical path).
USE_AGGRIGATOR=True
AGGRIGATOR_BASE_URL=http://localhost:8001
# HMAC, same value as aggregator's AGG_WEBHOOK_SECRET. Verifies inbound webhooks.
AGGRIGATOR_WEBHOOK_SECRET=
# HMAC for the OUTBOUND "Paradise" channel (MDProject → /v1/internal/*).
# Same value as aggregator's AGG_PARADISE_SECRET. NEVER reuse the webhook secret.
PARADISE_SECRET=

# --- Stripe ---
# Server-side secret key (sk_test_* in dev, sk_live_* in prod). Use a
# RESTRICTED key with only the scopes the app needs.
STRIPE_SECRET_KEY=
# Only needed if rendering Stripe Elements / JS. Leave blank for the
# redirect-to-Checkout flow.
STRIPE_PUBLISHABLE_KEY=
# Signing secret for /billing/stripe/webhook. Dev: from `stripe listen`.
# Prod: Stripe Dashboard → Developers → Webhooks → your endpoint.
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2025-07-30.basil
# PRO plan price in dollars (e.g. 2.99). `manage.py sync_platform_cost`
# pushes the new amount into Stripe via the Plan catalog.
PLATFORM_COST=

# --- platform kill-switch (paired with aggregator's ANALYTICS_FREE_FOR_ALL) ---
# 1 = every logged-in user is entitled to analytics; checkout is blocked.
# Run `./manage.py sync_kill_switch` after flipping to pause/resume Stripe subs.
ANALYTICS_FREE_FOR_ALL=0

# --- S3 / media storage (Bucketeer add-on) ---
BUCKETEER_AWS_ACCESS_KEY_ID=
BUCKETEER_AWS_SECRET_ACCESS_KEY=
BUCKETEER_BUCKET_NAME=
BUCKETEER_AWS_REGION=

# MDProject env. Copy to .env and edit. The .env file is loaded by
# python-dotenv at the top of CoreRoot/settings.py.
#
# Anything left blank below is REQUIRED in production (and surfaces a clear
# error at startup) — DEBUG, SECRET_KEY, ALLOWED_HOSTS in particular.

# ---------- Django core ----------
# Generate a real value with: ``python -c "import secrets; print(secrets.token_urlsafe(64))"``
SECRET_KEY=replace-me-with-a-real-64-byte-secret

# ``True`` enables Django's debug mode + auto-reload + dev-only HOST/cookie
# defaults. Must be ``False`` in production.
DEBUG=True

# Comma-separated. In DEBUG=True mode, ``localhost,127.0.0.1,testserver``
# are auto-added; in production set the actual hostname(s) you'll serve at.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ---------- Database ----------
# Local dev default: Homebrew Postgres 18 on port 5434.
DATABASE_URL=postgres://localhost:5434/mdproject?sslmode=disable

# ---------- Redis / Celery / channel layer ----------
REDIS_URL=redis://localhost:6379

# ---------- Email ----------
# Console backend prints emails to the runserver terminal — fine for dev.
# Production: switch to ``django.core.mail.backends.smtp.EmailBackend`` and
# fill in the SMTP creds below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_SSL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ---------- Aggregator integration ----------
# Source-of-truth for events / odds / settlement. Set ``USE_AGGRIGATOR=False``
# only as a rollback escape hatch — every read in the portal expects True.
USE_AGGRIGATOR=True
AGGRIGATOR_BASE_URL=http://localhost:8001
# Long-lived service-tier key minted via the aggregator's ``/v1/api-keys/`` API
# (or seeded via fixtures in dev).
AGGRIGATOR_API_KEY=

# Inbound webhook HMAC secret — must equal what the aggregator stored at
# webhook-endpoint registration time. Generated by
# ``aggrigator/scripts/register_webhook.py``; rotate by running it again
# with --rotate.
AGGRIGATOR_WEBHOOK_SECRET=

# ---------- SportsGameOdds (legacy local-DB path) ----------
# Only consulted when USE_AGGRIGATOR=False. With the aggregator on, leave
# the key blank — MDProject never calls SGO directly anymore.
SPORTSGAMEODDS_API_KEY=

# Dev-only knob: bypasses per-league cadence + per-event TTL + monthly cap
# in the legacy ingest path. NEVER set True in production — burns through
# the SGO entity quota in seconds.
EVENTS_DEBUG_FORCE_FRESH=False

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_COST=

# ---------- AWS S3 / media storage (Bucketeer add-on) ----------
BUCKETEER_AWS_ACCESS_KEY_ID=
BUCKETEER_AWS_SECRET_ACCESS_KEY=
BUCKETEER_BUCKET_NAME=
BUCKETEER_AWS_REGION=
